# ──────────────────────────────────────────────
# GENERAL
# ──────────────────────────────────────────────
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_SETTINGS_MODULE=config.settings.local

# ──────────────────────────────────────────────
# DATABASE — PostgreSQL connection URL
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:root@localhost:5432/sentine

DB_NAME=sentine
DB_USER=postgres
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=5432
CONN_MAX_AGE=60
# General

# ──────────────────────────────────────────────
# REDIS — Broker & result backend
# ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────────────────────
# EMAIL
# ──────────────────────────────────────────────
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=BTP Sentinel <noreply@btp-sentinel.hooyia.net>
DJANGO_SERVER_EMAIL=noreply@btp-sentinel.hooyia.net
DJANGO_EMAIL_SUBJECT_PREFIX=[BTP Sentinel]

# ──────────────────────────────────────────────
# ADMIN
# ──────────────────────────────────────────────
DJANGO_ADMIN_URL=admin/
DJANGO_ADMIN_FORCE_ALLAUTH=False

# ──────────────────────────────────────────────
# SECURITY — production only
# ──────────────────────────────────────────────
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True

# ──────────────────────────────────────────────
# ALLAUTH
# ──────────────────────────────────────────────
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True

# ──────────────────────────────────────────────
# DOCKER (local only — set to "yes" inside Docker)
# ──────────────────────────────────────────────
USE_DOCKER=no

